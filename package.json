{
  "name": "worship-app",
  "version": "2.2.1",
  "description": "Free and open-source church presentation software: slides, video, Bible and timers on a second screen.",
  "main": "./out/main/index.js",
  "author": "Nicolas Amorosi",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/NicolasAmorosi/lumina-live#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicolasAmorosi/lumina-live.git"
  },
  "bugs": {
    "url": "https://github.com/NicolasAmorosi/lumina-live/issues"
  },
  "type": "module",
  "scripts": {
    "postinstall": "install-electron && tsx scripts/fetch-binaries.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "npm run build && playwright test -c playwright.screenshots.config.ts",
    "db:generate": "drizzle-kit generate",
    "fetch:binaries": "tsx scripts/fetch-binaries.ts",
    "package": "npm run build && tsx scripts/fetch-binaries.ts && electron-builder",
    "package:win": "npm run build && tsx scripts/fetch-binaries.ts win32-x64 && electron-builder --win",
    "package:mac": "npm run build && tsx scripts/fetch-binaries.ts darwin-arm64 && electron-builder --mac",
    "package:linux": "npm run build && tsx scripts/fetch-binaries.ts linux-x64 && electron-builder --linux -c.productName=lumina-live",
    "package:dir": "npm run build && tsx scripts/fetch-binaries.ts && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "6.8.9",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.27.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.1.12",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.worshipapp.app",
    "productName": "Lumina Live",
    "artifactName": "Lumina-Live-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "files": [
      "out/**",
      "package.json",
      "!**/node_modules/@napi-rs/**",
      "!**/node_modules/pdfjs-dist/{build,web,image_decoders}/**"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "migrations"
      },
      {
        "from": "resources/bibles",
        "to": "bibles"
      },
      {
        "from": "resources/ooxml",
        "to": "ooxml"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/ffmpeg/win32-${arch}",
          "to": "ffmpeg",
          "filter": [
            "**/*",
            "!.stamp"
          ]
        },
        {
          "from": "resources/engine/win32-${arch}",
          "to": "engine",
          "filter": [
            "**/*",
            "!.stamp",
            "!.local"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "resources/ffmpeg/darwin-${arch}",
          "to": "ffmpeg",
          "filter": [
            "**/*",
            "!.stamp"
          ]
        },
        {
          "from": "resources/engine/darwin-${arch}",
          "to": "engine",
          "filter": [
            "**/*",
            "!.stamp",
            "!.local"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Nicolas Amorosi <nicolasamorosi@gmail.com>",
      "synopsis": "Church presentation software",
      "desktop": {
        "entry": {
          "Name": "Lumina Live"
        }
      },
      "extraResources": [
        {
          "from": "resources/ffmpeg/linux-${arch}",
          "to": "ffmpeg",
          "filter": [
            "**/*",
            "!.stamp"
          ]
        },
        {
          "from": "resources/engine/linux-${arch}",
          "to": "engine",
          "filter": [
            "**/*",
            "!.stamp",
            "!.local"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es"
      ],
      "language": "3082"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libmpv2 | libmpv1",
        "libopengl0"
      ]
    }
  }
}
